__pycache__/
*.py[cod]
.venv/
venv/
src/env/
logs/
*.log
.DS_Store
.pytest_cache/
*.egg-info/

# Never commit real customer data. Fixtures must be synthetic.
# API *shapes* (docs/api-shapes/) are masked and safe — real exports are not.
*.xlsx
*.xls
*.csv
*.sql
*.dump
# ...except the dealer flow spec, which is documentation, not data.
!docs/dealer-whatsapp-flows/*.xlsx

# Never commit credentials.
.env
.env.*
*.pem
*secret*
*credential*

# Prompt-tuning playground output (diffs against agents/*.py — reviewed by hand,
# never applied automatically, and never a place API keys should land).
#
# Everything here is ignored EXCEPT the prompt store. The published prompt is
# authored work, it is what the bot actually runs, and it was living on one
# laptop with no backup and no review trail while the records it points at were
# in the repo. Same reasoning the knowledge base is versioned here: git is the
# audit trail and a PR is the approval.
#
# Still ignored, deliberately: `chats/` holds transcripts carrying customer
# names and phone numbers, and `attachments/` is megabytes of uploaded photos
# and clips. Neither belongs in the repo.
.playground/*
!.playground/prompts/
.playground/prompts/*
!.playground/prompts/*.json

# Session worktrees created by the Claude Code EnterWorktree tool
.claude/worktrees/
